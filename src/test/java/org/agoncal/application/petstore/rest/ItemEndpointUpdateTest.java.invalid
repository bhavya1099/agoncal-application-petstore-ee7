package org.agoncal.application.petstore.rest;
import io.swagger.annotations.ApiOperation;
import javax.ejb.Stateless;
import javax.persistence.*;
import javax.ws.rs.*;
import javax.ws.rs.core.Response;
import javax.ws.rs.core.Response.Status;
import javax.ws.rs.core.UriBuilder;
import java.util.List;
import org.junit.*;
import static org.junit.Assert.*;
import org.mockito.*;
import org.junit.experimental.categories.Category;
import org.agoncal.application.petstore.model.Item;
import io.swagger.annotations.Api;
import org.agoncal.application.petstore.util.Loggable;

@Stateless
@Api
public class ItemEndpointUpdateTest {
    @Mock
    private EntityManager em;
    private ItemEndpoint itemEndpoint;
    @Before
    public void setUp() {
        MockitoAnnotations.initMocks(this);
        itemEndpoint = new ItemEndpoint();
        itemEndpoint.em = em;
    }
    @Test
    @Category(Categories.valid.class)
    public void testValidItemUpdate() throws Exception {
        Item mockItem = Mockito.mock(Item.class);
        Mockito.doReturn(null).when(em).merge(mockItem);
        Response response = itemEndpoint.update(mockItem);
        assertEquals(Status.NO_CONTENT.getStatusCode(), response.getStatus());
    }
    @Test
    @Category(Categories.invalid.class)
    public void testItemUpdateOptimisticLockException() throws Exception {
        Item mockItem = Mockito.mock(Item.class);
        Mockito.doThrow(OptimisticLockException.class).when(em).merge(mockItem);
        Response response = itemEndpoint.update(mockItem);
        assertEquals(Status.CONFLICT.getStatusCode(), response.getStatus());
    }
    @Test
    @Category(Categories.invalid.class)
    public void testInvalidItemUpdate() throws Exception {
        Item mockItem = Mockito.mock(Item.class);
        Mockito.doThrow(RuntimeException.class).when(em).merge(mockItem);
        Response response = itemEndpoint.update(mockItem);
        assertNotEquals(Status.NO_CONTENT.getStatusCode(), response.getStatus());
        assertNotEquals(Status.CONFLICT.getStatusCode(), response.getStatus());
    }
  
    @Test(expected = IllegalArgumentException.class)
    @Category(Categories.invalid.class)
    public void testItemUpdateWithNullItem() {
        itemEndpoint.update(null);
    }
} 