package org.agoncal.application.petstore.rest;
import org.agoncal.application.petstore.model.Product;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import javax.persistence.EntityManager;
import javax.ws.rs.core.Response;
import javax.ws.rs.*;
import static org.mockito.Mockito.*;
import static org.junit.Assert.*;
import io.swagger.annotations.Api;
import io.swagger.annotations.ApiOperation;
import org.agoncal.application.petstore.util.Loggable;
import javax.ejb.Stateless;
import javax.persistence.*;
import javax.ws.rs.core.Response.Status;
import javax.ws.rs.core.UriBuilder;
import java.util.List;

public class ProductEndpointDeleteByIdTest {
    @Test
    @Category(Categories.valid.class)
    public void testSuccessfulProductDeletion() {
        // Arrange
        Long validProductId = 1L;
        Product product = new Product();
        EntityManager em = mock(EntityManager.class);
        when(em.find(Product.class, validProductId)).thenReturn(product);
        ProductEndpoint productEndpoint = new ProductEndpoint();
        productEndpoint.em = em;
        // Act
        Response response = productEndpoint.deleteById(validProductId);
        // Assert
        verify(em).remove(product);
        assertEquals(Response.Status.NO_CONTENT.getStatusCode(), response.getStatus());
    }
    @Test
    @Category(Categories.valid.class)
    public void testDeletingNonexistingProduct() {
        // Arrange
        Long nonExistingProductId = 1L;
        EntityManager em = mock(EntityManager.class);
        when(em.find(Product.class, nonExistingProductId)).thenReturn(null);
        ProductEndpoint productEndpoint = new ProductEndpoint();
        productEndpoint.em = em;
        // Act
        Response response = productEndpoint.deleteById(nonExistingProductId);
        // Assert
        assertEquals(Response.Status.NOT_FOUND.getStatusCode(), response.getStatus());
    }
    @Test(expected = IllegalArgumentException.class)
    @Category(Categories.invalid.class)
    public void testDeletingNullProductId() {
        // Arrange 
        // No arrangement needed for this test 
        ProductEndpoint productEndpoint = new ProductEndpoint();
        // Act
        productEndpoint.deleteById(null);
        // Assert
        // Expected exception is checked by the @Test annotation 
    }
}