package org.agoncal.application.petstore.rest;
import org.agoncal.application.petstore.model.Country;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import javax.persistence.EntityManager;
import javax.persistence.NoResultException;
import javax.persistence.TypedQuery;
import javax.ws.rs.core.Response;
import static org.mockito.Mockito.*;
import io.swagger.annotations.Api;
import io.swagger.annotations.ApiOperation;
import org.agoncal.application.petstore.util.Loggable;
import javax.ejb.Stateless;
import javax.persistence.*;
import javax.ws.rs.*;
import javax.ws.rs.core.Response.Status;
import javax.ws.rs.core.UriBuilder;
import java.util.List;

public class CountryEndpointFindByIdTest {
    @Category(Categories.valid.class)
    @Test
    public void validateRetrievedCountryById() {
        EntityManager entityManager = mock(EntityManager.class);
        TypedQuery<Country> typedQuery = mock(TypedQuery.class);
        when(entityManager.createQuery(anyString(), eq(Country.class))).thenReturn(typedQuery);
        when(typedQuery.getSingleResult()).thenReturn(new Country(1L));
        CountryEndpoint countryEndpoint = new CountryEndpoint();
        countryEndpoint.em = entityManager;
        Response response = countryEndpoint.findById(1L);
        Country country = (Country) response.getEntity();
        verify(entityManager).createQuery(anyString(), eq(Country.class));
        verify(typedQuery).setParameter(anyString(), eq(1L));
        assert country.getId().equals(1L);
    }
    @Category(Categories.invalid.class)
    @Test
    public void validateResponseForNonExistentId() {
        EntityManager entityManager = mock(EntityManager.class);
        TypedQuery<Country> typedQuery = mock(TypedQuery.class);
        when(entityManager.createQuery(anyString(), eq(Country.class))).thenReturn(typedQuery);
        when(typedQuery.getSingleResult()).thenThrow(NoResultException.class);
        CountryEndpoint countryEndpoint = new CountryEndpoint();
        countryEndpoint.em = entityManager;
        Response response = countryEndpoint.findById(1234L);
        assert response.getStatus() == Response.Status.NOT_FOUND.getStatusCode();
        verify(entityManager).createQuery(anyString(), eq(Country.class));
        verify(typedQuery).setParameter(anyString(), eq(1234L));
    }
    @Category(Categories.integration.class)
    @Test(expected = RuntimeException.class)
    public void validateExceptionHandling() {
        EntityManager entityManager = mock(EntityManager.class);
        when(entityManager.createQuery(anyString(), eq(Country.class))).thenThrow(RuntimeException.class);
        CountryEndpoint countryEndpoint = new CountryEndpoint();
        countryEndpoint.em = entityManager;
        countryEndpoint.findById(1L);
    }
}