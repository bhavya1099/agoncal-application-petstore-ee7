package org.agoncal.application.petstore.rest;
import org.agoncal.application.petstore.model.Item;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import static org.junit.Assert.assertEquals;
import static org.mockito.Mockito.*;
import javax.persistence.EntityManager;
import javax.persistence.TypedQuery;
import java.util.Arrays;
import java.util.List;
import io.swagger.annotations.Api;
import io.swagger.annotations.ApiOperation;
import org.agoncal.application.petstore.util.Loggable;
import javax.ejb.Stateless;
import javax.persistence.*;
import javax.ws.rs.*;
import javax.ws.rs.core.Response;
import javax.ws.rs.core.Response.Status;
import javax.ws.rs.core.UriBuilder;

public class ItemEndpointListAllTest {
    private EntityManager em = mock(EntityManager.class);
    @Test
    @Category(Categories.valid.class)
    public void testListAllWithNoParameters() {
        ItemEndpoint testEndpoint = new ItemEndpoint();
        testEndpoint.em = this.em;
        TypedQuery mockedQuery = mock(TypedQuery.class);
        List<Item> expectedList = Arrays.asList(new Item(), new Item(), new Item());
        when(em.createQuery(anyString(), eq(Item.class))).thenReturn(mockedQuery);
        when(mockedQuery.getResultList()).thenReturn(expectedList);
        List<Item> actualList = testEndpoint.listAll(null, null);
        assertEquals(expectedList.size(), actualList.size());
    }
    @Test
    @Category(Categories.valid.class)
    public void testListAllWithStartPosition() {
        ItemEndpoint testEndpoint = new ItemEndpoint();
        testEndpoint.em = this.em;
        TypedQuery mockedQuery = mock(TypedQuery.class);
        when(em.createQuery(anyString(), eq(Item.class))).thenReturn(mockedQuery);
        int startPosition = 2;
        List<Item> expectedList = Arrays.asList(new Item(), new Item());
        when(mockedQuery.setFirstResult(startPosition)).thenReturn(mockedQuery);
        when(mockedQuery.getResultList()).thenReturn(expectedList);
        List<Item> actualList = testEndpoint.listAll(startPosition, null);
        assertEquals(expectedList.size(), actualList.size());
    }
    @Test
    @Category(Categories.valid.class)
    public void testListAllWithMaxResults() {
        ItemEndpoint testEndpoint = new ItemEndpoint();
        testEndpoint.em = this.em;
        TypedQuery mockedQuery = mock(TypedQuery.class);
        when(em.createQuery(anyString(), eq(Item.class))).thenReturn(mockedQuery);
        int maxResult = 3;
        List<Item> expectedList = Arrays.asList(new Item(), new Item(), new Item());
        when(mockedQuery.setMaxResults(maxResult)).thenReturn(mockedQuery);
        when(mockedQuery.getResultList()).thenReturn(expectedList);
        List<Item> actualList = testEndpoint.listAll(null, maxResult);
        
        assertEquals(expectedList.size(), actualList.size());
    }
}