package org.agoncal.application.petstore.rest;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import org.agoncal.application.petstore.model.Item;
import org.mockito.*;
import javax.ws.rs.core.Response;
import javax.ws.rs.core.UriBuilder;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;
import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertTrue;
import io.swagger.annotations.Api;
import io.swagger.annotations.ApiOperation;
import org.agoncal.application.petstore.util.Loggable;
import javax.ejb.Stateless;
import javax.persistence.*;
import javax.ws.rs.*;
import javax.ws.rs.core.Response.Status;
import java.util.List;

public class ItemEndpointCreateTest {
    @Mock
    EntityManager em;
    @InjectMocks
    ItemEndpoint itemEndpoint;
    @Category(Categories.valid.class)
    @Test
    public void testItemPersistence() {
        Item item = new Item();
        item.setId(1L);
        MockitoAnnotations.initMocks(this);
        itemEndpoint.create(item);
        verify(em).persist(item);
    }
    @Category(Categories.valid.class)
    @Test
    public void testResponseGenerationForCreatedItem() {
        Item item = new Item();
        item.setId(1L);
        MockitoAnnotations.initMocks(this);
        Response response = itemEndpoint.create(item);
        assertEquals(response.getStatus(), Response.Status.CREATED.getStatusCode());
    }
    @Category(Categories.valid.class)
    @Test
    public void testUriPathCreationForNewItem() {
        Item item = new Item();
        item.setId(1L);
        MockitoAnnotations.initMocks(this);
        Response response = itemEndpoint.create(item);
        String location = "/items/" + item.getId();
        
        assertTrue(response.getLocation().getPath().endsWith(location));
    }
}