package org.agoncal.application.petstore.rest;
import io.swagger.annotations.ApiOperation;
import org.agoncal.application.petstore.model.Category;
import org.junit.experimental.categories.Category;
import org.junit.Assert;
import org.junit.Before;
import org.junit.Test;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.MockitoAnnotations;
import javax.persistence.EntityManager;
import javax.persistence.OptimisticLockException;
import javax.ws.rs.core.Response;
import io.swagger.annotations.Api;
import org.agoncal.application.petstore.util.Loggable;
import javax.ejb.Stateless;
import javax.persistence.*;
import javax.ws.rs.*;
import javax.ws.rs.core.Response.Status;
import javax.ws.rs.core.UriBuilder;
import java.util.List;

public class CategoryEndpointUpdateTest {
  
  @Mock 
  private EntityManager em;
  
  private CategoryEndpoint categoryEndpoint;
  
  @Before
  public void setUp() {
    MockitoAnnotations.initMocks(this);
    categoryEndpoint = new CategoryEndpoint();
    categoryEndpoint.em = em;
  }
  @Test
  @Category(Categories.valid.class)
  public void testSuccessfulCategoryUpdate() {
    Category category = new Category();
    Mockito.when(em.merge(category)).thenReturn(category);
    
    Response response = categoryEndpoint.update(category);
    Assert.assertEquals(Response.Status.NO_CONTENT.getStatusCode(), response.getStatus());
    Mockito.verify(em).merge(category);
  }
  @Test
  @Category(Categories.invalid.class)
  public void testUpdatingNonExistentCategory() {
    Category category = new Category();
    Mockito.when(em.merge(category)).thenThrow(new OptimisticLockException(category));
    
    Response response = categoryEndpoint.update(category);
    Assert.assertEquals(Response.Status.CONFLICT.getStatusCode(), response.getStatus());
    Assert.assertEquals(category, response.getEntity());
  }
  @Test
  @Category(Categories.invalid.class)
  public void testUpdatingNullCategory() {
    Mockito.when(em.merge(null)).thenThrow(new OptimisticLockException());
    Response response = categoryEndpoint.update(null);
    Assert.assertEquals(Response.Status.CONFLICT.getStatusCode(), response.getStatus());
  }
}