package org.agoncal.application.petstore.rest;import org.agoncal.application.petstore.model.Category;
import org.jboss.arquillian.junit.Arquillian;
import org.junit.Test;
import org.junit.runner.RunWith;
import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNull;
import static org.junit.Assert.assertNotNull;
import java.util.List;
import javax.persistence.*;
import javax.ws.rs.*;
import javax.ws.rs.core.Response.Status;
import javax.ws.rs.core.Response;
import javax.ws.rs.core.UriBuilder;
import io.swagger.annotations.Api;
import io.swagger.annotations.ApiOperation;
import org.agoncal.application.petstore.util.Loggable;
import javax.ejb.Stateless;
import org.mockito.Mock;
import org.mockito.Mockito;
import static org.mockito.Mockito.when;
import org.mockito.InjectMocks;

@RunWith(Arquillian.class)
public class CategoryEndpointFindByIdTest {
    @Mock
    private EntityManager em;
    @InjectMocks
    private CategoryEndpoint categoryEndpoint = new CategoryEndpoint();
    
    // Test Scenario 1
    @Test
    public void testFindCategoryByIdValid() {
        Long id = 1L;
        
        Category mockCategory = Mockito.mock(Category.class);
        Mockito.when(mockCategory.getId()).thenReturn(id);
        Query findByIdQueryMock = Mockito.mock(Query.class);
        when(em.createQuery("SELECT DISTINCT c FROM Category c WHERE c.id = :entityId ORDER BY c.id", Category.class)).thenReturn(findByIdQueryMock);
        when(findByIdQueryMock.setParameter("entityId", id)).thenReturn(findByIdQueryMock);
        when(findByIdQueryMock.getSingleResult()).thenReturn(mockCategory);
        Response response = categoryEndpoint.findById(id);
        Category fetchedCategory = (Category) response.getEntity();
        assertEquals("Returned Status not as expected", Response.Status.OK.getStatusCode(), response.getStatus());
        assertNotNull("Returned category is null", fetchedCategory);
        assertEquals("Returned Category is not as expected", mockCategory.getId(), fetchedCategory.getId());
    }
    // Test Scenario 2
    @Test
    public void testFindCategoryByIdInvalid() {
        Long id = 1L;
        
        Query findByIdQueryMock = Mockito.mock(Query.class);
        when(em.createQuery("SELECT DISTINCT c FROM Category c WHERE c.id = :entityId ORDER BY c.id", Category.class)).thenReturn(findByIdQueryMock);
        when(findByIdQueryMock.setParameter("entityId", id)).thenReturn(findByIdQueryMock);
        when(findByIdQueryMock.getSingleResult()).thenReturn(null);
        Response response = categoryEndpoint.findById(id);
        Category fetchedCategory = (Category) response.getEntity();
        assertEquals("Returned status not as expected", Response.Status.NOT_FOUND.getStatusCode(), response.getStatus());
        assertNull("Returned Category is expected to be null", fetchedCategory);
    }
    // Test Scenario 3
    @Test(expected = NullPointerException.class)
    public void testFindCategoryByIdNullException() {
        categoryEndpoint.findById(null);
    }
}