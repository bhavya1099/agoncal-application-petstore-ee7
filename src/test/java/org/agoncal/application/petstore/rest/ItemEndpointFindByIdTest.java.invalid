package org.agoncal.application.petstore.rest;
import org.junit.*;
import static org.junit.Assert.*;
import org.mockito.*;
import javax.ws.rs.core.Response;
import javax.persistence.*;
import org.agoncal.application.petstore.model.Item;
import org.junit.experimental.categories.Category;
import io.swagger.annotations.Api;
import io.swagger.annotations.ApiOperation;
import org.agoncal.application.petstore.util.Loggable;
import javax.ejb.Stateless;
import javax.ws.rs.*;
import javax.ws.rs.core.Response.Status;
import javax.ws.rs.core.UriBuilder;
import java.util.List;

public class ItemEndpointFindByIdTest {
    @InjectMocks
    private ItemEndpoint itemEndpoint;
    @Mock
    private EntityManager em;
    @Mock
    private TypedQuery<Item> typedQuery;
    @Before
    public void setup() {
        MockitoAnnotations.initMocks(this);
    }
    @Test
    @Category(Categories.valid.class)
    public void findByExistingId() {
        Mockito.when(em.createQuery(Mockito.anyString(), Mockito.eq(Item.class))).thenReturn(typedQuery);
        Mockito.when(typedQuery.getSingleResult()).thenReturn(new Item());
        Response res = itemEndpoint.findById(1L);
        assertNotNull(res.getEntity());
        assertEquals(Response.Status.OK.getStatusCode(), res.getStatus());
    }
    @Test
    @Category(Categories.invalid.class)
    public void findByNonExistingId() {
        Mockito.when(em.createQuery(Mockito.anyString(), Mockito.eq(Item.class))).thenReturn(typedQuery);
        Mockito.when(typedQuery.getSingleResult()).thenThrow(new NoResultException());
        Response res = itemEndpoint.findById(2L);
        assertNull(res.getEntity());
        assertEquals(Response.Status.NOT_FOUND.getStatusCode(), res.getStatus());
    }
    @Test(expected = IllegalArgumentException.class)
    @Category(Categories.boundary.class)
    public void findByIdWithNullId() {
        itemEndpoint.findById(null);
    }
}