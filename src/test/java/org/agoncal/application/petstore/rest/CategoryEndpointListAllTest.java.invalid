@RunWith(MockitoJUnitRunner.class)
public class CategoryEndpointListAllTest {
    @InjectMocks
    private CategoryEndpoint categoryEndpoint;
    @Mock
    private EntityManager em;
    @Mock
    private TypedQuery<Category> findAllQuery;
    @Test
    @org.junit.experimental.categories.Category(org.agoncal.application.petstore.test.Categories.valid.class)
    public void testListAllWithValidInput() {
        List<Category> expectedList = Arrays.asList(new Category(), new Category(), new Category());
        when(em.createQuery(anyString(), any())).thenReturn(findAllQuery);
        when(findAllQuery.setFirstResult(anyInt())).thenReturn(findAllQuery);
        when(findAllQuery.setMaxResults(anyInt())).thenReturn(findAllQuery);
        when(findAllQuery.getResultList()).thenReturn(expectedList);
        List<Category> result = categoryEndpoint.listAll(0, 3);
        assertEquals(expectedList, result);
    }
    @Test
    @org.junit.experimental.categories.Category(org.agoncal.application.petstore.test.Categories.valid.class)
    public void testListAllWithNullInput() {
        List<Category> expectedList = Arrays.asList(new Category(), new Category());
        when(em.createQuery(anyString(), any())).thenReturn(findAllQuery);
        when(findAllQuery.getResultList()).thenReturn(expectedList);
        List<Category> result = categoryEndpoint.listAll(null, null);
        assertEquals(expectedList, result);
    }
    @Test
    @org.junit.experimental.categories.Category(org.agoncal.application.petstore.test.Categories.boundary.class)
    public void testListAllWithOnlyStartPosition() {
        List<Category> expectedList = Arrays.asList(new Category(), new Category(), new Category());
        when(em.createQuery(anyString(), any())).thenReturn(findAllQuery);
        when(findAllQuery.setFirstResult(anyInt())).thenReturn(findAllQuery);
        when(findAllQuery.getResultList()).thenReturn(expectedList);
        List<Category> result = categoryEndpoint.listAll(1, null);
        assertEquals(expectedList, result);
    }
    @Test
    @org.junit.experimental.categories.Category(org.agoncal.application.petstore.test.Categories.boundary.class)
    public void testListAllWithInvalidMaxResult() {
        when(em.createQuery(anyString(), any())).thenReturn(findAllQuery);
        when(findAllQuery.setMaxResults(anyInt())).thenReturn(findAllQuery);
        when(findAllQuery.getResultList()).thenReturn(Arrays.asList());
        List<Category> result = categoryEndpoint.listAll(0, 100);
