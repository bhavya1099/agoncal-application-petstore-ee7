package org.agoncal.application.petstore.rest;
import io.swagger.annotations.ApiOperation;
import javax.ejb.Stateless;
import javax.persistence.*;
import javax.ws.rs.*;
import javax.ws.rs.Path;
import javax.ws.rs.core.Response;
import javax.ws.rs.core.Response.Status;
import javax.ws.rs.core.UriBuilder;
import org.agoncal.application.petstore.model.Country;
import org.mockito.Mockito;
import org.junit.Test;
import org.junit.Assert;
import org.junit.experimental.categories.Category;
import org.junit.runner.RunWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;
import io.swagger.annotations.Api;
import org.agoncal.application.petstore.util.Loggable;
import java.util.List;

@RunWith(MockitoJUnitRunner.class)
public class CountryEndpointDeleteByIdTest {
    @InjectMocks
    CountryEndpoint countryEndpoint;
    @Mock
    EntityManager em;
    @Test
    @Category(Categories.valid.class)
    public void testDeleteByIdExistingId() {
        //Arrange
        Long id = 100L;
        Country entity = new Country();
        Mockito.when(em.find(Country.class, id)).thenReturn(entity);
        //Act
        Response response = countryEndpoint.deleteById(id);
        //Assert
        Assert.assertEquals(Status.NO_CONTENT.getStatusCode(), response.getStatus());
        Mockito.verify(em, Mockito.times(1)).remove(entity);
    }
    @Test
    @Category(Categories.invalid.class)
    public void testDeleteByIdNonExistingId() {
        //Arrange
        Long id = 100L;
        Mockito.when(em.find(Country.class, id)).thenReturn(null);
        //Act
        Response response = countryEndpoint.deleteById(id);
        //Assert
        Assert.assertEquals(Status.NOT_FOUND.getStatusCode(), response.getStatus());
        Mockito.verify(em, Mockito.never()).remove(Mockito.any(Country.class));
    }
    @Test
    @Category(Categories.boundary.class)
    public void testDeleteByIdWithNullId() {
        //Arrange
        Long id = null;
        
        //Act
        Response response = countryEndpoint.deleteById(id);
        //Assert
        Assert.assertEquals(Status.NOT_FOUND.getStatusCode(), response.getStatus());
        Mockito.verify(em, Mockito.never()).remove(Mockito.any(Country.class));
    }
}