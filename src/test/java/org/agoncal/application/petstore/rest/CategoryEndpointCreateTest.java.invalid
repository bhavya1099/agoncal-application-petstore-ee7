package org.agoncal.application.petstore.rest;
import io.swagger.annotations.Api;
import io.swagger.annotations.ApiOperation;
import org.agoncal.application.petstore.model.Category;
import org.junit.experimental.categories.Category;
import org.mockito.Matchers;
import org.mockito.Mockito;
import org.junit.Before;
import org.junit.Test;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import javax.ws.rs.core.Response;
import static org.junit.Assert.assertEquals;
import static org.mockito.Mockito.verify;
import org.agoncal.application.petstore.util.Loggable;
import javax.ejb.Stateless;
import javax.persistence.*;
import javax.ws.rs.*;
import javax.ws.rs.core.Response.Status;
import javax.ws.rs.core.UriBuilder;
import java.util.List;

public class CategoryEndpointCreateTest {
    @InjectMocks
    private CategoryEndpoint mockCategoryEndpoint;
    
    @Mock
    private Category mockEntity;
    
    @Before
    public void setUp() {
        MockitoAnnotations.initMocks(this);
    }
    @Test
    @Category(Categories.valid.class)
    public void testCreateTestCategoryWithValidParameters() {
        Response expectedResponse = Response.status(Response.Status.CREATED).build();
        Mockito.when(mockCategoryEndpoint.create(Matchers.any(Category.class))).thenReturn(expectedResponse);
        Category entity = new Category();
        entity.setId(1L);
        entity.setName("category1");
        Response response = mockCategoryEndpoint.create(entity);
        assertEquals(expectedResponse.getStatus(), response.getStatus());
    }
    @Test(expected = NullPointerException.class)
    @Category(Categories.invalid.class)
    public void testCreateTestCategoryWithNullParameter() {
        mockCategoryEndpoint.create(null);
    }
    @Test(expected = EntityExistsException.class)
    @Category(Categories.boundary.class)
    public void testCreateTestCategoryThatAlreadyExists() {
        Category entity = new Category();
        entity.setId(1L);
        entity.setName("category1");
        Response response = mockCategoryEndpoint.create(entity);
        assertEquals(Response.Status.CONFLICT.getStatusCode(), response.getStatus());
    }
    @Test(expected = IllegalArgumentException.class)
    @Category(Categories.boundary.class)
    public void testCreateTestCategoryWithInvalidParameters() {
        Category entity = new Category();
        entity.setId(-1L);
        entity.setName("#InvalidCategory");
        mockCategoryEndpoint.create(entity);
    }
}