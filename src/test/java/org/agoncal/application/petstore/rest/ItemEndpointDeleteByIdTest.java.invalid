package org.agoncal.application.petstore.rest;
import io.swagger.annotations.ApiOperation;
import org.agoncal.application.petstore.model.Item;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import javax.persistence.EntityManager;
import javax.ws.rs.core.Response;
import javax.ws.rs.ext.Provider;
import static org.junit.Assert.assertEquals;
import static org.mockito.Mockito.*;
import io.swagger.annotations.Api;
import org.agoncal.application.petstore.util.Loggable;
import javax.ejb.Stateless;
import javax.persistence.*;
import javax.ws.rs.*;
import javax.ws.rs.core.Response.Status;
import javax.ws.rs.core.UriBuilder;
import java.util.List;

public class ItemEndpointDeleteByIdTest {
    @InjectMocks
    ItemEndpoint itemEndpoint;
    @Mock
    EntityManager em;
    @Category(Categories.valid.class)
    @Test
    public void deleteExistingItem() {
        Item item = new Item();
        when(em.find(Item.class, 1L)).thenReturn(item);
        Response response = itemEndpoint.deleteById(1L);
        assertEquals(Response.Status.NO_CONTENT.getStatusCode(), response.getStatus());
        verify(em, times(1)).remove(item);
    }
    @Category(Categories.invalid.class)
    @Test
    public void deleteNonExistingItem() {
        when(em.find(Item.class, 1L)).thenReturn(null);
        Response response = itemEndpoint.deleteById(1L);
        assertEquals(Response.Status.NOT_FOUND.getStatusCode(), response.getStatus());
        verify(em, never()).remove(any());
    }
    @Category(Categories.invalid.class)
    @Test
    public void deleteItemWithNegativeId() {
        when(em.find(Item.class, -1L)).thenReturn(null);
        Response response = itemEndpoint.deleteById(-1L);
        assertEquals(Response.Status.NOT_FOUND.getStatusCode(), response.getStatus());
        verify(em, never()).remove(any());
    }
    @Category(Categories.invalid.class)
    @Test(expected = NullPointerException.class)
    public void deleteItemWithNullId() {
        itemEndpoint.deleteById(null);
    }
    @Category(Categories.integration.class)
    @Test
    public void concurrentDelete() throws InterruptedException {
        Item item = new Item();
        when(em.find(Item.class, 1L)).thenReturn(item).thenReturn(null);
        Thread t1 = new Thread(()->itemEndpoint.deleteById(1L));
        Thread t2 = new Thread(()->itemEndpoint.deleteById(1L));
        t1.start();
        t2.start();
        t1.join();
        t2.join();
        verify(em, times(1)).remove(item);
    }
}