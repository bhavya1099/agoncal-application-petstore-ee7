package org.agoncal.application.petstore.rest;
import io.swagger.annotations.ApiOperation;
import javax.ws.rs.Consumes;
import javax.ws.rs.POST;
import javax.ws.rs.core.Response;
import org.agoncal.application.petstore.model.Country;
import org.junit.Before;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNotNull;
import static org.mockito.Mockito.doThrow;
import static org.mockito.Mockito.verify;
import io.swagger.annotations.Api;
import org.agoncal.application.petstore.util.Loggable;
import javax.ejb.Stateless;
import javax.persistence.*;
import javax.ws.rs.*;
import javax.ws.rs.core.Response.Status;
import javax.ws.rs.core.UriBuilder;
import java.util.List;

public class CountryEndpointCreateTest {
    @InjectMocks
    private CountryEndpoint countryEndpoint;
    @Mock
    private EntityManager em;
    @Mock
    private Country country;
    @Before
    public void init() {
        MockitoAnnotations.initMocks(this);
    }
    @Test
    @Category(Categories.valid.class)
    public void testCreateCountry() {
        Response response = countryEndpoint.create(country);
        assertNotNull(response);
        assertEquals(response.getStatus(), Response.Status.OK.getStatusCode());
        verify(em).persist(country);
    }
    @Test(expected = IllegalArgumentException.class)
    @Category(Categories.invalid.class)
    public void testCreateCountryWithNullParam() {
        countryEndpoint.create(null);
    }
    @Test(expected = PersistenceException.class)
    @Category(Categories.boundary.class)
    public void testCreateCountryExceptionHandling() {
        doThrow(PersistenceException.class).when(em).persist(country);
        countryEndpoint.create(country);
    }
}