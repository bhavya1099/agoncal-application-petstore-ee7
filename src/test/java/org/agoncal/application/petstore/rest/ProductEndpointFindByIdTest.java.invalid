package org.agoncal.application.petstore.rest;
import java.util.List;
import javax.persistence.*;
import javax.ws.rs.core.Response;
import javax.ws.rs.core.Response.Status;
import org.junit.Assert;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mockito;
import io.swagger.annotations.ApiOperation;
import org.agoncal.application.petstore.model.Product;
import org.junit.experimental.categories.Category;
import org.mockito.runners.MockitoJUnitRunner;
import io.swagger.annotations.Api;
import org.agoncal.application.petstore.util.Loggable;
import javax.ejb.Stateless;
import javax.ws.rs.*;
import javax.ws.rs.core.UriBuilder;

@RunWith(MockitoJUnitRunner.class)
public class ProductEndpointFindByIdTest {
    
    private static final Long VALID_PRODUCT_ID = 1L;
    private static final Long INVALID_PRODUCT_ID = 2L;
    @Test
    @Category(Categories.valid.class)
    public void productFoundWithValidId() {
        EntityManager entityManagerMock = Mockito.mock(EntityManager.class);
        TypedQuery typedQueryMock = Mockito.mock(TypedQuery.class);
        Product mockProduct = Mockito.mock(Product.class);
        Mockito.when(entityManagerMock.createQuery(Mockito.anyString(), Mockito.eq(Product.class))).thenReturn(typedQueryMock);
        Mockito.when(typedQueryMock.setParameter(Mockito.eq("entityId"), Mockito.eq(VALID_PRODUCT_ID))).thenReturn(typedQueryMock);
        Mockito.when(typedQueryMock.getSingleResult()).thenReturn(mockProduct);
        ProductEndpoint productEndpoint = new ProductEndpoint();
        productEndpoint.em = entityManagerMock;
        Response response = productEndpoint.findById(VALID_PRODUCT_ID);
        Assert.assertNotNull(response.getEntity());
        Assert.assertEquals(Response.Status.OK.getStatusCode(), response.getStatus());
        Mockito.verify(entityManagerMock).createQuery(Mockito.anyString(), Mockito.eq(Product.class));
        Mockito.verify(typedQueryMock).setParameter(Mockito.eq("entityId"), Mockito.eq(VALID_PRODUCT_ID));
  }
  @Test
  @Category(Categories.invalid.class)
  public void productNotFoundWithInvalidId() {
    EntityManager entityManagerMock = Mockito.mock(EntityManager.class);
    TypedQuery typedQueryMock = Mockito.mock(TypedQuery.class);
    Mockito.when(entityManagerMock.createQuery(Mockito.anyString(), Mockito.eq(Product.class))).thenReturn(typedQueryMock);
    Mockito.when(typedQueryMock.setParameter(Mockito.eq("entityId"), Mockito.eq(INVALID_PRODUCT_ID))).thenReturn(typedQueryMock);
    Mockito.when(typedQueryMock.getSingleResult()).thenThrow(new NoResultException());
    ProductEndpoint productEndpoint = new ProductEndpoint();
    productEndpoint.em = entityManagerMock;
    Response response = productEndpoint.findById(INVALID_PRODUCT_ID);
    Assert.assertEquals(Response.Status.NOT_FOUND.getStatusCode(), response.getStatus());
  }
  @Test
  @Category(Categories.invalid.class)
  public void nullIdProvided() {
    ProductEndpoint productEndpoint = new ProductEndpoint();
    Response response = productEndpoint.findById(null);
    Assert.assertEquals(Response.Status.BAD_REQUEST.getStatusCode(), response.getStatus());
  }
  @Test
  @Category(Categories.integration.class)
  public void databaseThrowsException() {
    EntityManager entityManagerMock = Mockito.mock(EntityManager.class);
    TypedQuery typedQueryMock = Mockito.mock(TypedQuery.class);
    Mockito.when(entityManagerMock.createQuery(Mockito.anyString(), Mockito.eq(Product.class))).thenReturn(typedQueryMock);
    Mockito.when(typedQueryMock.setParameter(Mockito.eq("entityId"), Mockito.eq(VALID_PRODUCT_ID))).thenThrow(new RuntimeException());
    ProductEndpoint productEndpoint = new ProductEndpoint();
    productEndpoint.em = entityManagerMock;
    try {
        productEndpoint.findById(VALID_PRODUCT_ID);
    } catch (RuntimeException expected) {
        Assert.assertTrue(true);
    }
  }
}