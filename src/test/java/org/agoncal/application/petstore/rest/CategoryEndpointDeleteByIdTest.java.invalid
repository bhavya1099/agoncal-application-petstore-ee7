package org.agoncal.application.petstore.rest;import org.agoncal.application.petstore.model.Category;
import org.junit.Before;
import org.junit.Test;
import javax.ejb.Stateless;
import javax.persistence.*;
import javax.ws.rs.*;
import javax.ws.rs.core.Response;
import java.util.List;
import static org.junit.Assert.*;
import static org.mockito.Mockito.*;
import io.swagger.annotations.Api;
import io.swagger.annotations.ApiOperation;
import org.agoncal.application.petstore.util.Loggable;
import javax.ws.rs.core.Response.Status;
import javax.ws.rs.core.UriBuilder;

public class CategoryEndpointDeleteByIdTest {
    private EntityManager em;
    private CategoryEndpoint categoryEndpoint;
    @Before
    public void setup() {
        em = mock(EntityManager.class);
        categoryEndpoint = new CategoryEndpoint();
        categoryEndpoint.setEm(em); // using setter
    }
    @Test
    public void testDeleteByIdWithValidCategoryId() {
        Category category = new Category();
        category.setId(1L);
        when(em.find(Category.class, 1L)).thenReturn(category);
        Response response = categoryEndpoint.deleteById(1L);
        verify(em, times(1)).remove(category);
        assertEquals(response.getStatus(), Response.Status.NO_CONTENT.getStatusCode());
    }
    @Test
    public void testDeleteByIdWithInvalidCategoryId() {
        when(em.find(Category.class, 1L)).thenReturn(null);
        Response response = categoryEndpoint.deleteById(1L);
        assertEquals(response.getStatus(), Response.Status.NOT_FOUND.getStatusCode());
    }
    @Test
    public void testDatabaseStatePostDeletion() {
        Category category = new Category();
        category.setId(1L);
        when(em.find(Category.class, 1L)).thenReturn(category);
        Query query = mock(Query.class); // defining missing mock
        List categoryList = mock(List.class);
        when(categoryList.size()).thenReturn(10);
        when(em.createQuery("SELECT DISTINCT c FROM Category c ORDER BY c.id", Category.class)).thenReturn(query);
        when(query.getResultList()).thenReturn(categoryList);
        Response response = categoryEndpoint.deleteById(1L);
        assertEquals(response.getStatus(), Response.Status.NO_CONTENT.getStatusCode());
        when(categoryList.size()).thenReturn(9);
        assertEquals(9, categoryEndpoint.listAll(null, null).size());
    }
}