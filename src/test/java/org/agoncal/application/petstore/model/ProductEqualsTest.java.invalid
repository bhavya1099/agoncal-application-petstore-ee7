package org.agoncal.application.petstore.model;import org.junit.Test;
import org.junit.experimental.categories.Category;
import javax.persistence.*;
import javax.validation.constraints.NotNull;
import javax.validation.constraints.Size;
import javax.xml.bind.annotation.XmlRootElement;
import javax.xml.bind.annotation.XmlTransient;
import java.io.Serializable;
import java.util.Objects;
import static org.junit.Assert.assertFalse;
import static org.junit.Assert.assertTrue;

//Define new marker interface categories
interface InvalidCategory {}
interface ValidCategory {}
public class ProductEqualsTest {
    @Category(InvalidCategory.class)
    @Test
    public void testEqualsWithNull() {
        Product product1 = new Product("name", "description", new Category("categoryName", "categoryDescription"));
        assertFalse(product1.equals(null));
    }
    
    @Category(ValidCategory.class)
    @Test
    public void testEqualsWithIdenticalInstances() {
        Product product1 = new Product("name", "description", new Category("categoryName", "categoryDescription"));
        Product product2 = new Product("name", "description", new Category("categoryName", "categoryDescription"));
        assertTrue(product1.equals(product2));
    }
    
    @Category(ValidCategory.class)
    @Test
    public void testEqualsWithDifferentInstances() {
        Product product1 = new Product("name", "description", new Category("categoryName", "categoryDescription"));
        Product product2 = new Product("differentName", "differentDescription", new Category("categoryName", "categoryDescription"));
        assertFalse(product1.equals(product2));
    }
    
    @Category(ValidCategory.class)
    @Test
    public void testEqualsWithItself() {
        Product product1 = new Product("name", "description", new Category("categoryName", "categoryDescription"));
        assertTrue(product1.equals(product1));
    }
    
    @Category(InvalidCategory.class)
    @Test
    public void testEqualsWithDifferentClass() {
        Product product1 = new Product("name", "description", new Category("categoryName", "categoryDescription"));
        Category category1 = new Category("categoryName", "categoryDescription");
        assertFalse(product1.equals(category1));
    }
}