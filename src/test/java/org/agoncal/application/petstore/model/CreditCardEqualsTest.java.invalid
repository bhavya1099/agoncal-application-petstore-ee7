package org.agoncal.application.petstore.model;import java.io.Serializable;
import java.util.Objects;
import javax.persistence.Column;
import javax.persistence.Embeddable;
import javax.persistence.Enumerated;
import javax.validation.constraints.NotNull;
import javax.validation.constraints.Size;
import org.junit.Test;
import org.junit.experimental.categories.Category;

public class CreditCardEqualsTest {
    @Test
    @Category(Categories.valid.class)
    public void testSameObjectInstance() {
        CreditCard creditCard = new CreditCard("1234567890123456", CreditCardType.VISA, "12/25");
        assertTrue(creditCard.equals((Object) creditCard));
    }
    @Test
    @Category(Categories.invalid.class)
    public void testDifferentObjectType() {
        CreditCard creditCard = new CreditCard("1234567890123456", CreditCardType.VISA, "12/25");
        String notACreditCard = "Not a CreditCard";
        assertFalse(creditCard.equals((Object) notACreditCard));
    }
    @Test
    @Category(Categories.invalid.class)
    public void testDifferentCreditCardNumber() {
        CreditCard creditCard1 = new CreditCard("1234567890123456", CreditCardType.VISA, "12/25");
        CreditCard creditCard2 = new CreditCard("0987654321098765", CreditCardType.VISA, "12/25");
        assertFalse(creditCard1.equals((Object) creditCard2));
    }
    @Test
    @Category(Categories.invalid.class)
    public void testDifferentCreditCardType() {
        CreditCard creditCard1 = new CreditCard("1234567890123456", CreditCardType.VISA, "12/25");
        CreditCard creditCard2 = new CreditCard("1234567890123456", CreditCardType.MASTERCARD, "12/25");
        assertFalse(creditCard1.equals((Object) creditCard2));
    }
    @Test
    @Category(Categories.invalid.class)
    public void testDifferentCreditCardExpDate() {
        CreditCard creditCard1 = new CreditCard("1234567890123456", CreditCardType.VISA, "12/25");
        CreditCard creditCard2 = new CreditCard("1234567890123456", CreditCardType.VISA, "12/26");
        assertFalse(creditCard1.equals((Object) creditCard2));
    }
    @Test
    @Category(Categories.valid.class)
    public void testIdenticalFields() {
        CreditCard creditCard1 = new CreditCard("1234567890123456", CreditCardType.VISA, "12/25");
        CreditCard creditCard2 = new CreditCard("1234567890123456", CreditCardType.VISA, "12/25");
        assertTrue(creditCard1.equals((Object) creditCard2));
    }
    @Test
    @Category(Categories.invalid.class)
    public void testNullCreditCardNumber() {
        CreditCard creditCard1 = new CreditCard(null, CreditCardType.VISA, "12/25");
        CreditCard creditCard2 = new CreditCard("1234567890123456", CreditCardType.VISA, "12/25");
        assertFalse(creditCard1.equals((Object) creditCard2));
    }
    @Test
    @Category(Categories.invalid.class)
    public void testNullCreditCardType() {
        CreditCard creditCard1 = new CreditCard("1234567890123456", null, "12/25");
