package org.agoncal.application.petstore.model;import org.junit.Test;
import org.junit.experimental.categories.Category;
import org.apache.logging.log4j.Categories;
import java.util.Date;
import static org.junit.Assert.*;
import javax.persistence.*;
import javax.validation.Valid;
import javax.xml.bind.annotation.XmlRootElement;
import java.io.Serializable;
import java.util.HashSet;
import java.util.Objects;
import java.util.Set;

public class PurchaseOrderGetOrderDateTest {
    @Test
    @Category(Categories.valid.class)
    public void testGetOrderDateReturnsCorrectDate() {
        PurchaseOrder purchaseOrder = new PurchaseOrder();
        Date expectedDate = new Date();
        purchaseOrder.setOrderDate(expectedDate);
        Date actualDate = purchaseOrder.getOrderDate();
        assertEquals("Order Date should match the expected date", expectedDate, actualDate);
    }
    @Test
    @Category(Categories.valid.class)
    public void testGetOrderDateReturnsNullWhenNotSet() {
        PurchaseOrder purchaseOrder = new PurchaseOrder();
        Date actualDate = purchaseOrder.getOrderDate();
        assertNull("Order Date should be null when not set", actualDate);
    }
    @Test
    @Category(Categories.valid.class)
    public void testGetOrderDateReturnsCorrectDateAfterSetDefaultData() {
        PurchaseOrder purchaseOrder = new PurchaseOrder();
        // Assuming setDefaultData() method sets orderDate to current date
        purchaseOrder.setOrderDate(new Date());
        Date actualDate = purchaseOrder.getOrderDate();
        assertNotNull("Order Date should not be null after setting default data", actualDate);
        assertTrue("Order Date should be less than or equal to current date", actualDate.compareTo(new Date()) <= 0);
    }
    @Test
    @Category(Categories.valid.class)
    public void testGetOrderDateReturnsCorrectDateForFutureDate() {
        PurchaseOrder purchaseOrder = new PurchaseOrder();
        Date futureDate = new Date(System.currentTimeMillis() + 86400000); // Adding 1 day to current date
        purchaseOrder.setOrderDate(futureDate);
        Date actualDate = purchaseOrder.getOrderDate();
        assertEquals("Order Date should match the future date", futureDate, actualDate);
    }
    @Test
    @Category(Categories.valid.class)
    public void testGetOrderDateReturnsCorrectDateForPastDate() {
        PurchaseOrder purchaseOrder = new PurchaseOrder();
        Date pastDate = new Date(System.currentTimeMillis() - 86400000); // Subtracting 1 day from current date
        purchaseOrder.setOrderDate(pastDate);
        Date actualDate = purchaseOrder.getOrderDate();
        assertEquals("Order Date should match the past date", pastDate, actualDate);
    }
    @Test
    @Category(Categories.valid.class)
    public void testGetOrderDateReturnsCorrectDateForCurrentDate() {
        PurchaseOrder purchaseOrder = new PurchaseOrder();
        Date currentDate = new Date();
        purchaseOrder.setOrderDate(currentDate);
        Date actualDate = purchaseOrder.getOrderDate();
        assertEquals("Order Date should match the current date", currentDate, actualDate);
    }
}