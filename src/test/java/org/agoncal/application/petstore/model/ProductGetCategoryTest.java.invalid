import java.io.Serializable;
import java.util.Objects;
import org.junit.experimental.categories.Category;
import org.junit.Before;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.junit.runners.JUnit4;
import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNull;

@RunWith(JUnit4.class)
public class ProductGetCategoryTest {
    private Product product1;
    private Product product2;
    @Before
    public void setup() {
        product1 = new Product();
        product2 = new Product();
    }
    @Test
    @Category(Categories.valid.class)
    public void testGetCategoryWithNonNullCategory() {
        PetCategory category = new PetCategory();
        product1.setCategory(category);
        PetCategory output = product1.getCategory();
        assertEquals("The output category should match the set category", category, output);
    }
    @Test
    @Category(Categories.invalid.class)
    public void testGetCategoryWithNullCategory() {
        PetCategory output = product1.getCategory();
        assertNull("The output category should be null since no category was set", output);
    }
    @Test
    @Category(Categories.integration.class)
    public void testGetCategoryForDifferentProducts() {
        PetCategory category1 = new PetCategory();
        PetCategory category2 = new PetCategory();
        product1.setCategory(category1);
        product2.setCategory(category2);
        PetCategory output1 = product1.getCategory();
        PetCategory output2 = product2.getCategory();
        assertEquals("The output category should match the set category for product1", category1, output1);
        assertEquals("The output category should match the set category for product2", category2, output2);
    }
}