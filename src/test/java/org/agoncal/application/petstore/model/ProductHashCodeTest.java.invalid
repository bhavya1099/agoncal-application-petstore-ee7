import javax.validation.constraints.Size;
import javax.xml.bind.annotation.XmlRootElement;
import javax.xml.bind.annotation.XmlTransient;
import java.io.Serializable;
import java.util.Objects;

public class ProductHashCodeTest {
    public static class Categories {
        public static class valid{}
    }
    @Test
    @org.junit.experimental.categories.Category(Categories.valid.class)
    public void testHashCodeEqualityForSameProductDetails() {
        Product product1 = new Product("Product1", "Product1 description", new Category("Category1", "Category1 description"));
        Product product2 = new Product("Product1", "Product1 description", new Category("Category1", "Category1 description"));
        int hashCodeProduct1 = product1.hashCode();
        int hashCodeProduct2 = product2.hashCode();
        Assert.assertEquals(hashCodeProduct1, hashCodeProduct2);
    }
    
    @Test
    @org.junit.experimental.categories.Category(Categories.valid.class)
    public void testHashCodeInequalityForDifferentProductDetails() {
        Product product1 = new Product("Product1", "Product1 description", new Category("Category1", "Category1 description"));
        Product product2 = new Product("Product2", "Product2 description", new Category("Category2", "Category2 description"));
        int hashCodeProduct1 = product1.hashCode();
        int hashCodeProduct2 = product2.hashCode();
        Assert.assertNotEquals(hashCodeProduct1, hashCodeProduct2);
    }
    
    @Test
    @org.junit.experimental.categories.Category(Categories.valid.class)
    public void testHashCodeWithNullValues() {
        Product product1 = new Product(null, null, new Category(null, null));
        try {
            int hashCodeProduct1 = product1.hashCode();
            Assert.assertTrue(true); // the code executed successfully without an exception
        } catch (NullPointerException e) {
            Assert.assertFalse(true); // the code threw a NullPointerException exception
        }
    }
    @Test
    public void equalsAndHashCodeContract(){
