package org.agoncal.application.petstore.model;import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNull;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import javax.validation.constraints.NotNull;
import java.io.Serializable;
import java.util.Objects;
import javax.persistence.Column;
import javax.persistence.Embeddable;
import javax.persistence.Enumerated;
import javax.validation.constraints.Size;

public class CreditCardGetCreditCardTypeTest {
    @Test
    @Category(Categories.invalid.class)
    public void testWhenCreditCardTypeIsNull() {
        // Arrange
        CreditCard creditCard = new CreditCard();
        // Act
        CreditCardType result = creditCard.getCreditCardType();
        // Assert
        assertNull(result);
    }
    @Test
    @Category(Categories.valid.class)
    public void testWhenCreditCardTypeIsSet() {
        // Arrange
        CreditCard creditCard = new CreditCard();
        creditCard.setCreditCardType(CreditCardType.MASTERCARD);
        // Act
        CreditCardType result = creditCard.getCreditCardType();
        // Assert
        assertEquals(CreditCardType.MASTERCARD, result);
    }
    @Test
    @Category(Categories.boundary.class)
    public void testWhenCreditCardTypeIsChanged() {
        // Arrange
        CreditCard creditCard = new CreditCard();
        creditCard.setCreditCardType(CreditCardType.MASTERCARD);
        creditCard.setCreditCardType(CreditCardType.VISA);
        // Act
        CreditCardType result = creditCard.getCreditCardType();
        // Assert
        assertEquals(CreditCardType.VISA, result);
    }
    @Test
    @Category(Categories.integration.class)
    public void testWhenMultipleCreditCardsHaveDifferentCreditCardTypes() {
        // Arrange
        CreditCard creditCard1 = new CreditCard();
        CreditCard creditCard2 = new CreditCard();
        creditCard1.setCreditCardType(CreditCardType.MASTERCARD);
        creditCard2.setCreditCardType(CreditCardType.VISA);
        // Act
        CreditCardType result1 = creditCard1.getCreditCardType();
        CreditCardType result2 = creditCard2.getCreditCardType();
        // Assert
        assertEquals(CreditCardType.MASTERCARD, result1);
        assertEquals(CreditCardType.VISA, result2);
    }
}