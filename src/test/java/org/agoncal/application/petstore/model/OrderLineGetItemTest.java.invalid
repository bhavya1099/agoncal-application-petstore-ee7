public class OrderLineGetItemTest {
    // Test Scenario: Test if getItem method returns the correct item set
    @Category(Categories.valid.class)
    @Test
    public void testGetCorrectItem() {
        // Arrange
        Item mockItem = Mockito.mock(Item.class);
        OrderLine orderLine = new OrderLine();
        orderLine.setItem(mockItem);
        // Act
        Item returnedItem = orderLine.getItem();
        // Assert
        assertSame("The returned item should be the same as the set item", mockItem, returnedItem);
    }
    // Test Scenario: Test if getItem method returns null when no item is set 
    @Category(Categories.valid.class)
