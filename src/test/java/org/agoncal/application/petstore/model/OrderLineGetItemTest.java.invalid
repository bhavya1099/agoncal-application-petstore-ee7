        // Assert
        assertNull("The returned item should be null", returnedItem);
    }
    // Test Scenario: Test if getItem method works correctly with multiple OrderLine objects
    @Category(Categories.valid.class)
    @Test
    public void testGetItemWithMultipleOrderLines() {
        // Arrange
        Item mockItem1 = Mockito.mock(Item.class);
        Item mockItem2 = Mockito.mock(Item.class);
        OrderLine orderLine1 = new OrderLine();
        OrderLine orderLine2 = new OrderLine();
        orderLine1.setItem(mockItem1);
        orderLine2.setItem(mockItem2);
        // Act and Assert
        Item returnedItem1 = orderLine1.getItem();
