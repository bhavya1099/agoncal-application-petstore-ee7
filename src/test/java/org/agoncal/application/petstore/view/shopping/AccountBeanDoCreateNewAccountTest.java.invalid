    @Test
    @Category(Categories.valid.class)
    public void testSuccessfulAccountCreation() {
        accountBean.getCredentials().setLogin("login");
        accountBean.getCredentials().setPassword("password");
        accountBean.getCredentials().setPassword2("password");
        when(customerService.doesLoginAlreadyExist("login")).thenReturn(false);
        String result = accountBean.doCreateNewAccount();
