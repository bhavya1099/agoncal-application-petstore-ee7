@RunWith(MockitoJUnitRunner.class)
public class AccountBeanDoCreateNewAccountTest {
    @InjectMocks
    private AccountBean accountBean;
    @Mock
    private CustomerService customerService;
    @Before
    public void setUp() {
        accountBean.setCredentials(new CredentialsBean());
    }
    @Test
    @Category(Categories.invalid.class)
    public void testWhenLoginAlreadyExists() {
        accountBean.getCredentials().setLogin("existingLogin");
        when(customerService.doesLoginAlreadyExist("existingLogin")).thenReturn(true);
        String result = accountBean.doCreateNewAccount();
        assertEquals("login_exists", accountBean.getFacesMessage());
        assertEquals(null, result);
    }
    @Test
    @Category(Categories.invalid.class)
    public void testWhenIdOrPasswordNotFilled() {
        accountBean.getCredentials().setLogin("");
        accountBean.getCredentials().setPassword("password");
        accountBean.getCredentials().setPassword2("password");
        String result = accountBean.doCreateNewAccount();
        assertEquals("id_pwd_filled", accountBean.getFacesMessage());
        assertEquals(null, result);
