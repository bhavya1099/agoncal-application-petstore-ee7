@RunWith(MockitoJUnitRunner.class)
public class AccountBeanDoCreateCustomerTest {
    @InjectMocks
    AccountBean accountBean;
    @Mock
    CustomerService customerService;
    @Test
    @Category(Categories.valid.class)
    public void testSuccessfulCustomerCreation() {
        Customer mockCustomer = new Customer();
        when(customerService.createCustomer(Mockito.any(Customer.class))).thenReturn(mockCustomer);
        accountBean.setLoggedinCustomer(mockCustomer);
        String result = accountBean.doCreateCustomer();
        assertEquals("main.faces", result);
        assertEquals(mockCustomer, accountBean.getLoggedinCustomer());
    }
    @Test(expected = RuntimeException.class)
    @Category(Categories.invalid.class)
    public void testCustomerCreationFailure() {
        when(customerService.createCustomer(Mockito.any(Customer.class))).thenThrow(RuntimeException.class);
        Customer mockCustomer = new Customer();
        accountBean.setLoggedinCustomer(mockCustomer);
        accountBean.doCreateCustomer();
    }
    @Test(expected = NullPointerException.class)
    @Category(Categories.invalid.class)
    public void testNullLoggedinCustomer() {
        accountBean.setLoggedinCustomer(null);
        accountBean.doCreateCustomer();
    }
}