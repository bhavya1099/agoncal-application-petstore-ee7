package org.agoncal.application.petstore.view.shopping;import org.agoncal.application.petstore.model.Item;
import org.agoncal.application.petstore.service.CatalogService;
import org.junit.Assert;
import org.junit.Before;
import org.junit.Test;
import org.mockito.Mockito;
import java.util.Collections;
import java.util.List;
import org.agoncal.application.petstore.model.Product;
import org.agoncal.application.petstore.util.Loggable;
import org.agoncal.application.petstore.view.AbstractBean;
import org.agoncal.application.petstore.view.CatchException;
import javax.enterprise.context.SessionScoped;
import javax.inject.Inject;
import javax.inject.Named;
import java.io.Serializable;

public class CatalogBeanDoSearchTest {
    private CatalogBean catalogBean;
    @Before
    public void setup() {
        CatalogService catalogService = Mockito.mock(CatalogService.class);
        catalogBean = new CatalogBean();
        catalogBean.setCatalogService(catalogService);
    }
    @Test
    public void testSearchWithValidKeyword() {
        String keyword = "validKeyword";
        List<Item> expectedItems = Collections.singletonList(new Item());
        Mockito.when(catalogBean.getCatalogService().searchItems(keyword)).thenReturn(expectedItems);
        catalogBean.setKeyword(keyword);
        String result = catalogBean.doSearch();
        Assert.assertEquals("searchresult.faces&faces-redirect=true", result);
        Assert.assertEquals(expectedItems, catalogBean.getItems());
    }
    @Test
    public void testSearchWithInvalidKeyword() {
        String keyword = "invalidKeyword";
        Mockito.when(catalogBean.getCatalogService().searchItems(keyword)).thenReturn(Collections.emptyList());
        catalogBean.setKeyword(keyword);
        String result = catalogBean.doSearch();
        Assert.assertEquals("searchresult.faces&faces-redirect=true", result);
        Assert.assertTrue(catalogBean.getItems().isEmpty());
    }
    @Test
    public void testSearchWithNullKeyword() {
        catalogBean.setKeyword(null);
        String result = catalogBean.doSearch();
        Assert.assertEquals("searchresult.faces&faces-redirect=true", result);
        Assert.assertTrue(catalogBean.getItems().isEmpty());
    }
    @Test(expected = NullPointerException.class)
    public void testSearchWhenCatalogServiceIsNull() {
        catalogBean.setCatalogService(null);
        catalogBean.doSearch();
    }
}