package org.agoncal.application.petstore.view.shopping;
import org.agoncal.application.petstore.model.Item;
import org.agoncal.application.petstore.model.Product;
import org.agoncal.application.petstore.service.CatalogService;
import org.agoncal.application.petstore.view.AbstractBean;
import org.junit.Before;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import java.util.Arrays;
import java.util.List;
import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNull;
import static org.mockito.Mockito.*;
import org.agoncal.application.petstore.util.Loggable;
import org.agoncal.application.petstore.view.CatchException;
import javax.enterprise.context.SessionScoped;
import javax.inject.Inject;
import javax.inject.Named;
import java.io.Serializable;

public class CatalogBeanDoFindItemsTest {
    private CatalogBean catalogBean;
    @Mock
    private CatalogService mockCatalogService;
    @Before
    public void setUp() {
        MockitoAnnotations.initMocks(this);
        catalogBean = new CatalogBean();
        catalogBean.catalogService = mockCatalogService;
    }
    @Test
    @Category(Categories.invalid.class)
    public void testDoFindItemsWithNullProductId() {
        catalogBean.setProductId(null);
        String result = catalogBean.doFindItems();
        assertEquals("showitems.faces", result);
        assertNull(catalogBean.getProduct());
        assertNull(catalogBean.getItems());
    }
    @Test
    @Category(Categories.valid.class)
    public void testDoFindItemsWithValidProductId() {
        Long validProductId = 1L;
        Product mockProduct = mock(Product.class);
        List<Item> mockItems = Arrays.asList(mock(Item.class));
        when(mockCatalogService.findProduct(validProductId)).thenReturn(mockProduct);
        when(mockCatalogService.findItems(validProductId)).thenReturn(mockItems);
        catalogBean.setProductId(validProductId);
        String result = catalogBean.doFindItems();
        assertEquals("showitems.faces", result);
        assertEquals(mockProduct, catalogBean.getProduct());
        assertEquals(mockItems, catalogBean.getItems());
    }
    @Test
    @Category(Categories.valid.class)
    public void testDoFindItemsWhenServiceReturnsNull() {
        Long validProductId = 1L;
        when(mockCatalogService.findProduct(validProductId)).thenReturn(null);
        when(mockCatalogService.findItems(validProductId)).thenReturn(null);
        catalogBean.setProductId(validProductId);
        String result = catalogBean.doFindItems();
        assertEquals("showitems.faces", result);
        assertNull(catalogBean.getProduct());
        assertNull(catalogBean.getItems());
    }
    @Test(expected = RuntimeException.class)
    @Category(Categories.valid.class)
    public void testDoFindItemsWhenServiceThrowsException() {
        Long validProductId = 1L;
        when(mockCatalogService.findProduct(validProductId)).thenThrow(RuntimeException.class);
        when(mockCatalogService.findItems(validProductId)).thenThrow(RuntimeException.class);
        catalogBean.setProductId(validProductId);
        catalogBean.doFindItems();
    }
}