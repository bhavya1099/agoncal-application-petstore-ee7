package org.agoncal.application.petstore.view.shopping;
import org.agoncal.application.petstore.model.Product;
import org.agoncal.application.petstore.service.CatalogService;
import org.junit.Before;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import org.mockito.Mockito;
import java.util.Arrays;
import java.util.List;
import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNull;
import org.agoncal.application.petstore.model.Item;
import org.agoncal.application.petstore.util.Loggable;
import org.agoncal.application.petstore.view.AbstractBean;
import org.agoncal.application.petstore.view.CatchException;
import javax.enterprise.context.SessionScoped;
import javax.inject.Inject;
import javax.inject.Named;
import java.io.Serializable;

public class CatalogBeanDoFindProductsTest {
    private CatalogBean catalogBean;
    private CatalogService catalogService;
    @Before
    public void setup() {
        catalogService = Mockito.mock(CatalogService.class);
        catalogBean = new CatalogBean();
        catalogBean.catalogService = catalogService;
    }
    @Test
    @Category(Categories.valid.class)
    public void testDoFindProductsWithValidCategoryName() {
        // Arrange
        List<Product> expectedProducts = Arrays.asList(new Product(), new Product());
        String validCategoryName = "validCategory";
        Mockito.when(catalogService.findProducts(validCategoryName)).thenReturn(expectedProducts);
        catalogBean.setCategoryName(validCategoryName);
        // Act
        String result = catalogBean.doFindProducts();
        // Assert
        assertEquals("showproducts.faces", result);
        assertEquals(expectedProducts, catalogBean.getProducts());
    }
    @Test
    @Category(Categories.invalid.class)
    public void testDoFindProductsWithInvalidCategoryName() {
        // Arrange
        String invalidCategoryName = "invalidCategory";
        Mockito.when(catalogService.findProducts(invalidCategoryName)).thenReturn(null);
        catalogBean.setCategoryName(invalidCategoryName);
        // Act
        String result = catalogBean.doFindProducts();
        // Assert
        assertEquals("showproducts.faces", result);
        assertNull(catalogBean.getProducts());
    }
    @Test
    @Category(Categories.boundary.class)
    public void testDoFindProductsWithNullCategoryName() {
        // Arrange
        Mockito.when(catalogService.findProducts(null)).thenReturn(null);
        catalogBean.setCategoryName(null);
        // Act
        String result = catalogBean.doFindProducts();
        // Assert
        assertEquals("showproducts.faces", result);
        assertNull(catalogBean.getProducts());
    }
}